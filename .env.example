# Public — safe to expose to the browser. Used by both the client and server
# Supabase clients (src/lib/supabase/client.ts, src/lib/supabase/server.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY — never expose to the browser, never prefix with NEXT_PUBLIC_.
# The running app does NOT need this for normal operation: admin reads go
# through the authenticated server-side Supabase client (see
# src/lib/supabase/server.ts) and rely on the RLS policies in
# supabase/migrations/0002_rls_policies.sql. Only set this if you're running
# a one-off server-side script (e.g. a seed/admin-creation script) that
# genuinely needs elevated privileges outside the app's request flow.
SUPABASE_SERVICE_ROLE_KEY=
